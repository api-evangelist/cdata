          },
          "http": {
            "method": "POST",
            "url": "https://cloud.cdata.com/api/exec",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a stored procedure"
        }
      ]
    }
  ],
  "bundled": true
}